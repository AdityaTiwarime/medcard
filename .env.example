# Postgres connection string (Neon / Render). Leave unset to use a local SQLite file.
DATABASE_URL=postgresql+psycopg2://user:password@host/dbname?sslmode=require

# Any long random string. Keeps users logged in across restarts.
JWT_SECRET=change-me-to-a-long-random-string

# Optional AI. Set ONE of these; without them the app uses built-in offline answers.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# AI_MODEL=claude-haiku-5-5        # or gpt-4o-mini when using OpenAI
# AI_CALLS_PER_HOUR=40             # per-user limit that protects your key

# Login OTP (demo, no SMS provider connected)
# LOGIN_OTP=123456
